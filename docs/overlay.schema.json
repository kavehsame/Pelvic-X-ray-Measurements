{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PXM local AP implant overlays",
  "type": "object",
  "required": [
    "format",
    "units",
    "view",
    "axes",
    "items"
  ],
  "properties": {
    "format": {
      "const": "pxm-overlay-pack-1"
    },
    "units": {
      "const": "mm"
    },
    "view": {
      "const": "AP"
    },
    "axes": {
      "const": "x-lateral-y-superior"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "manufacturer",
          "family",
          "size",
          "reference",
          "source",
          "scale_method",
          "component",
          "side",
          "pivot",
          "outline"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "manufacturer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "size": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "scale_method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "component": {
            "enum": [
              "cup",
              "stem"
            ]
          },
          "side": {
            "enum": [
              "both",
              "left",
              "right"
            ]
          },
          "pivot": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": -2000,
              "maximum": 2000
            }
          },
          "outline": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4096,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": -2000,
                "maximum": 2000
              }
            }
          }
        }
      }
    }
  }
}
